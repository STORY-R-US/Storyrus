    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.3.1",
    "react-dom": "19.1.4",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
