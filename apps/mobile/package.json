{
  "name": "storyrus-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "test": "node --test",
    "android": "expo start --android",
    "ios": "expo start --ios",
