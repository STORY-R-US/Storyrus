# Copie para deploy/oracle/.env na VM. Não commite o .env.
# APP_ENV=prod recusa segredo vazio, "change-me" ou IMAGE_PROVIDER diferente de openai.

APP_ENV=prod
IMAGE_PROVIDER=openai
LOG_FORMAT=json

# Sem @, :, / ou # — a senha entra na URL do Postgres.
POSTGRES_PASSWORD=
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KLING_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

RESEND_API_KEY=
PUBLIC_WEB_ORIGIN=https://storyrus.ai
TRANSACTIONAL_FROM_EMAIL=Story R Us <noreply@storyrus.ai>
CADDY_EMAIL=info@storyrus.ai

STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

OWNER_EMAILS=eng.andrevitor89@gmail.com
USAGE_DASHBOARD_PASSWORD=
CREDIT_GRANT_SECRET=

OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=storyrus
